{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "lib/AuthContext.tsx",
    "app/(auth)/verify-link.tsx",
    "app/components/Profile/FormComponent.tsx"
  ]
}
